{
  "name": "charter-cloudflare-sender",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir build",
    "test": "npm run build && npm run build:transport && node --test test/*.test.mjs && python3 -m unittest discover -s test -p 'test_*.py' -v",
    "build:transport": "wrangler deploy --dry-run --config wrangler.transport.jsonc --outdir build/transport"
  },
  "dependencies": {
    "teleproto": "1.229.1"
  },
  "devDependencies": {
    "wrangler": "4.147.0",
    "@cloudflare/workers-types": "5.20261006.1"
  }
}
